# Copy to .env and fill in. Never commit .env.

# --- LLM provider (standalone brain only) ----------------------------------
# Needed for the standalone CLI to analyze resumes and answer free-text
# application questions. NOT needed when driving via Claude Code (MCP), where
# Claude Code is the brain.
#
# Set one (or both) key. Pick a provider explicitly with JOBHUNTER_PROVIDER,
# otherwise whichever key is present is used (Anthropic wins ties).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider ("anthropic" or "openai") and/or a model.
JOBHUNTER_PROVIDER=
JOBHUNTER_MODEL=

# --- Optional: auto-read signup verification codes -------------------------
# When a career site requires creating an account, the tool can read the
# emailed verification code. Use a Gmail App Password
# (https://myaccount.google.com/apppasswords), NOT your real password.
# Leave blank to have the tool pause and ask you for codes instead.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: where local state lives (profile, job db, browser session).
# Defaults to ~/.jobhunter
JOBHUNTER_HOME=
